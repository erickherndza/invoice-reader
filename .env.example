# Claves de acceso al servicio (separadas por coma). Genera una: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=
# Contraseña de PostgreSQL. Solo hex para no romper la URL: openssl rand -hex 24
POSTGRES_PASSWORD=
# groq | claude
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Opcionales
CLAUDE_MODEL=claude-haiku-5-5
GROQ_MODEL=qwen/qwen3.8-27b
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60
# 127.0.0.1 = solo esta máquina; 0.0.0.0 = visible en tu red (la cámara del navegador exige HTTPS)
WEB_BIND=127.0.0.1
